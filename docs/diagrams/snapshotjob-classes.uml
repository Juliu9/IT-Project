@startuml
allowmixing
!pragma layout smetana
title Shared book-vector snapshot publisher
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package snapshotjob {
  class BookVectorSnapshotApplication {
    + {static} void main(String[])
  }
  class SnapshotConfiguration {
    + {static} BookVectorSnapshot snapshot(Environment)
  }
  class SnapshotSources {
    ~ {static} Source solr(SolrAudiobookRepository)
    ~ {static} Source qdrant(QdrantClient,String)
  }
}
package "catalogue.snapshot" {
  class BookVectorSnapshot {
    + void rebuild(Source,int)
    + void validate()
    + Optional<float[]> findEmbeddingByBookId(String)
    + Map<String,float[]> findEmbeddingsByBookIds(Collection<String>)
  }
  interface "BookVectorSnapshot.Source" as Source {
    ~ Page page(String,int)
  }
}
interface "catalogue.port.AudiobookVectorRepository" as Vectors
class "embeddingjob.EmbeddingIndexApplication" as Embedding
class "userpreferencejob.UserPreferenceApplication" as Importer
artifact "Atomic, checksummed binary file" as File

BookVectorSnapshotApplication --> SnapshotConfiguration
SnapshotConfiguration --> SnapshotSources
SnapshotConfiguration --> BookVectorSnapshot
SnapshotSources ..> Source : creates read-only adapters
BookVectorSnapshot --> Source : paginated export
Vectors <|.. BookVectorSnapshot
BookVectorSnapshot --> File : publish or validate/load
Embedding --> BookVectorSnapshot : rebuild after generation
Importer --> BookVectorSnapshot : consume last compatible version

note bottom of BookVectorSnapshot
  Publishing failure preserves the previous file.
  Import checks backend, collection, model and dimensions.
  No age expiry; no remote fallback.
  The live recommendation server does not use this cache.
end note
@enduml
