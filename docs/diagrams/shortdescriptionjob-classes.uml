@startuml
title Short-description generation
skinparam classAttributeIconSize 0

package com.gen3.shortdescriptionjob {
  enum ShortDescriptionMode {
    MISSING_ONLY
    REBUILD_ALL
  }
  class ShortDescriptionApplication
  class ShortDescriptionEnricher {
    + run(ApplicationArguments)
  }
  package provider {
    interface ShortDescriptionGenerator {
      + Map<String, String> generate(List<AudiobookRecord>)
    }
    class OpenAiShortDescriptionGenerator
    ShortDescriptionGenerator <|.. OpenAiShortDescriptionGenerator
  }
  package store {
    interface AudiobookEnrichmentStore {
      + List<StoredAudiobook> findRecordsForShortDescription(int, ShortDescriptionMode)
      + void updateShortDescriptions(List<ShortDescriptionUpdate>, ShortDescriptionMode)
    }
    class SolrShortDescriptionStore
    class QdrantShortDescriptionStore
    AudiobookEnrichmentStore <|.. SolrShortDescriptionStore
    AudiobookEnrichmentStore <|.. QdrantShortDescriptionStore
  }
  ShortDescriptionApplication --> ShortDescriptionEnricher
  ShortDescriptionEnricher --> ShortDescriptionGenerator : <= 5 requests in flight; <= 10 books each
  ShortDescriptionEnricher --> AudiobookEnrichmentStore : select by mode / save completed request
}
@enduml
