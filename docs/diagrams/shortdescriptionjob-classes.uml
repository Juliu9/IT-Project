@startuml
!pragma layout smetana
title shortdescriptionjob
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "shortdescriptionjob" as shortdescriptionjob {
  package "provider" {
    class "OpenAiShortDescriptionBatchProvider" as C0 {
      - {static} Logger LOGGER
      - {static} int BOOKS_PER_REQUEST
      - ObjectMapper mapper
      - HttpClient client
      - String apiKey
      - String apiUrl
      - String model
      - Duration requestTimeout
      - Duration pollInterval
      + String id()
      + String upload(List<AudiobookRecord>,Path)
      + String submit(String)
      + void verifyTerminalFailure(String)
      + Map<String,String> completedDescriptions(String)
      - int writeBatchInput(Path,List<AudiobookRecord>)
      - List<List<AudiobookRecord>> groups(List<AudiobookRecord>)
      + ObjectNode batchRequest(List<AudiobookRecord>,int)
      - JsonNode upload(Path)
      - HttpRequest.BodyPublisher multipart(Path,String)
      + Map<String,String> parseDescriptions(String)
      - JsonNode postJson(String,JsonNode)
      - JsonNode getJson(String)
      - String getText(String)
      - String sendText(HttpRequest)
      - JsonNode sendJson(HttpRequest)
      - HttpRequest.Builder authorizedRequest(String)
      - {static} boolean hasText(String)
    }
    interface "ShortDescriptionBatchProvider" as C6 {
      ~ String id()
      ~ String upload(List<AudiobookRecord>,Path)
      ~ String submit(String)
      ~ void verifyTerminalFailure(String)
      ~ Map<String,String> completedDescriptions(String)
    }
  }
  package "store" {
    class "QdrantShortDescriptionStore" as C4 {
      - {static} String SHORT_DESCRIPTION
      - QdrantClient client
      - QdrantPointMapper mapper
      - String collection
      - String endpoint
      - int grpcPort
      + DatasetIdentity datasetIdentity()
      + void updateShortDescriptions(List<ShortDescriptionUpdate>)
      - PointsUpdateOperation setMissingPayload(io.qdrant.client.grpc.Common.PointId,String,io.qdrant.client.grpc.JsonWithInt.Value)
      + List<StoredAudiobook> findRecordsWithoutShortDescription(int)
      - io.qdrant.client.grpc.Common.PointId pointId(String)
      - void updatePayloads(List<PointsUpdateOperation>)
      - void requireCollection()
      - boolean hasText(String)
      - void createPayloadIndex(String)
      - T await(Future<T>,String)
    }
    class "SolrShortDescriptionStore" as C5 {
      - SolrClient client
      - SolrAudiobookRepository catalogue
      - String collection
      - String endpoint
      + DatasetIdentity datasetIdentity()
      + List<StoredAudiobook> findRecordsWithoutShortDescription(int)
      + void updateShortDescriptions(List<ShortDescriptionUpdate>)
    }
    interface "AudiobookEnrichmentStore" as C7 {
      ~ DatasetIdentity datasetIdentity()
      ~ {static} boolean eligible(StoredAudiobook)
      ~ List<StoredAudiobook> findRecordsWithoutShortDescription(int)
      ~ void updateShortDescriptions(List<ShortDescriptionUpdate>)
    }
    class "AudiobookEnrichmentStore$DatasetIdentity" as C8 {
      - String backend
      - String dataset
      + String dataset()
      + String backend()
    }
    class "AudiobookEnrichmentStore$ShortDescriptionUpdate" as C9 {
      - String storageReference
      - String description
      + String description()
      + String storageReference()
    }
  }
  class "BatchShortDescriptionEnricher" as C1 {
    - {static} Logger LOGGER
    - {static} int MAX_DESCRIPTION_WORDS
    - AudiobookEnrichmentStore enrichmentStore
    - ObjectMapper mapper
    - ShortDescriptionBatchProvider provider
    - String mode
    - String batchId
    - Path outputDirectory
    - int maximumRecords
    + void run(ApplicationArguments)
    - void submit()
    - List<StoredAudiobook> validBooks(List<StoredAudiobook>)
    - void importCompletedBatch()
    - String resolvedBatchId(BatchManifest)
    - void recoverFailedBatch()
    - Path manifestPath()
    ~ void writeManifest(Path,String,List<StoredAudiobook>)
    - BatchManifest readManifest()
    ~ Map<String,String> pendingStorageReferences()
    - {static} boolean hasText(String)
    - {static} String trimToWordLimit(String)
  }
  class "BatchShortDescriptionEnricher$StoredBatchManifest" as C2 {
    - String batchId
    - AudiobookEnrichmentStore.DatasetIdentity origin
    - Map<String,String> pointIds
    - String provider
    + String provider()
    + AudiobookEnrichmentStore.DatasetIdentity origin()
    + Map<String,String> pointIds()
    + String batchId()
  }
  class "BatchShortDescriptionEnricher$BatchManifest" as C3 {
    - String batchId
    - Map<String,String> storageReferences
    + Map<String,String> storageReferences()
    + String batchId()
  }
  class "ShortDescriptionApplication" as C10 {
    + {static} void main(String[])
    ~ {static} BeanFactoryPostProcessor validateJob(Environment)
  }
}


C6 <|.. C0
C1 +.. C2
C1 +.. C3
C7 <|.. C4
C7 <|.. C5
C7 +.. C8
C7 +.. C9
C1 --> C7
C1 --> C6

package "catalogue" as catalogue <<external>> {
}
shortdescriptionjob ..> catalogue : uses shared models

' Source: docs/maintenance.md
note right of shortdescriptionjob
  Separate opt-in submit/import/recover job.

  Generates spoiler-free summaries
  of at most 20 words.
  Writes missing short descriptions only;
  preserves existing summaries and vectors.

  Manifests retain provider, batch
  and dataset identity for recovery.

  No Redis or embedding generation is required.
end note
@enduml
