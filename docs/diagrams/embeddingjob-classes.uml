@startuml
!pragma layout smetana
title embeddingjob
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "embeddingjob" as embeddingjob {
  enum EmbeddingMode {
    MISSING_ONLY
    REBUILD_ALL
  }
  package "store" {
    interface "AudiobookEmbeddingStore" as C2 {
      ~ Page embeddingPage(String,int,EmbeddingMode)
      ~ void updateEmbeddings(List<Update>)
    }
    class "AudiobookEmbeddingStore$Page" as C3 {
      - List<StoredAudiobook> books
      - String nextCursor
      + String nextCursor()
      + List<StoredAudiobook> books()
    }
    class "AudiobookEmbeddingStore$Update" as C4 {
      - String storageReference
      - AudiobookEmbedding embedding
      + String storageReference()
      + AudiobookEmbedding embedding()
    }
    class "QdrantEmbeddingStore" as C6 {
      - QdrantClient client
      - QdrantPointMapper mapper
      - String collection
      - int vectorDimension
      - boolean checked
      + Page embeddingPage(String,int,EmbeddingMode)
      + void updateEmbeddings(List<Update>)
      - void requireCollection()
      - void validateDimension(float[])
      - io.qdrant.client.grpc.Common.PointId pointId(String)
      - T await(Future<T>,String)
    }
    class "SolrEmbeddingStore" as C7 {
      - SolrAudiobookRepository repository
      + Page embeddingPage(String,int,EmbeddingMode)
      + void updateEmbeddings(List<Update>)
    }
  }
  class "CatalogueEmbeddingJob" as C0 {
    - {static} Logger LOGGER
    - AudiobookEmbeddingStore store
    - AudiobookEmbeddingIndexer indexer
    - int pageSize
    - int maximumRecords
    - EmbeddingMode mode
    + void run()
  }
  class "EmbeddingIndexApplication" as C1 {
    + {static} void main(String[])
    ~ {static} BeanFactoryPostProcessor validateJob(Environment)
    ~ ApplicationRunner embeddingJob(AudiobookEmbeddingStore,EmbeddingModel,BookVectorSnapshot,Source,int,int,int,String)
  }
  class "AudiobookEmbeddingIndexer" as C5 {
    - EmbeddingModel model
    + String buildAudiobookText(AudiobookRecord)
    + List<AudiobookEmbedding> embedAudiobooks(List<AudiobookRecord>)
    - String part(String,String)
    - boolean hasText(String)
    - String part(String,List<String>)
  }
}

package "catalogue" as catalogue <<external>> {
  class BookVectorSnapshot
}

C2 +.. C3
C2 +.. C4
C2 <|.. C6
C2 <|.. C7
C0 --> C2
C0 --> C5
C4 ..> catalogue : uses
C7 ..> catalogue : uses
C1 --> BookVectorSnapshot : rebuild after successful generation

' Source: docs/maintenance.md
note right of embeddingjob
  Separate opt-in catalogue embedding job.

  Default missing-only fills absent dense vectors.
  Explicit rebuild-all regenerates existing vectors.
  Qdrant also receives sparse keyword vectors.
  Metadata and short descriptions are preserved.

  Uses the selected Solr or Qdrant database.
  No Redis is required.

  Missing-only reruns skip already-filled books.
  Rebuild-all reruns incur generation charges again.
  Snapshot-only retries use the standalone launcher.
end note
@enduml
